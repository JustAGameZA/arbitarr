<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Arbitarr.Architecture.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!--
      TestProcessGlobalStateTests reads the IL of the OTHER test assemblies to ban process-global
      calls. They cannot be ProjectReferences here (NU1605), so they are opened by file path and
      Cecil is referenced directly rather than relied on transitively via NetArchTest.
    -->
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Arbitarr.Core\Arbitarr.Core.csproj" />
    <ProjectReference Include="..\..\src\Arbitarr.Core.Identity\Arbitarr.Core.Identity.csproj" />
    <ProjectReference Include="..\..\src\Arbitarr.Ai\Arbitarr.Ai.csproj" />
    <ProjectReference Include="..\..\src\Arbitarr.Media\Arbitarr.Media.csproj" />
    <ProjectReference Include="..\..\src\Arbitarr.Api\Arbitarr.Api.csproj" />
    <ProjectReference Include="..\..\src\Arbitarr.Data\Arbitarr.Data.csproj" />
    <ProjectReference Include="..\..\src\Arbitarr.Sources.Newznab\Arbitarr.Sources.Newznab.csproj" />
    <ProjectReference Include="..\..\src\Arbitarr.Sources.NzbHydra\Arbitarr.Sources.NzbHydra.csproj" />
  </ItemGroup>

</Project>
