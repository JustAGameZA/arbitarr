<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Arbitarr.TestSupport</RootNamespace>
    <!--
      Shared helpers for test projects, not a test project itself: it holds no tests, so the test
      SDK and runner are deliberately absent. Adding them would make the runner discover (and
      report) an empty assembly, which shifts the CI test-count floor for no reason.
    -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.Data.Sqlite only. SqliteTestDatabase deliberately knows nothing about EF or about
      Arbitarr's own projects, so every test assembly can reference it without inheriting a
      dependency direction it should not have.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
