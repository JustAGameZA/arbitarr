<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Arbitarr.Media.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Arbitarr.Media\Arbitarr.Media.csproj" />
    <!-- arb-u1c: SeriesTitleResolver reads the Sonarr instance rows through ArrInstanceRepository,
         so its tests need a real ArbitarrDbContext. Arbitarr.Media already references Arbitarr.Data,
         so this adds no new dependency direction, only visibility of a type the subject takes. -->
    <ProjectReference Include="..\..\src\Arbitarr.Data\Arbitarr.Data.csproj" />
    <ProjectReference Include="..\Arbitarr.TestSupport\Arbitarr.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\fixtures\nzbhydra\*.xml" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
