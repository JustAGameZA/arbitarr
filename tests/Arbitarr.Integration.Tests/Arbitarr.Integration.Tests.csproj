<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Arbitarr.Integration.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Arbitarr.Host\Arbitarr.Host.csproj" />
    <ProjectReference Include="..\..\src\Arbitarr.Api\Arbitarr.Api.csproj" />
    <ProjectReference Include="..\..\src\Arbitarr.Data\Arbitarr.Data.csproj" />
    <ProjectReference Include="..\..\src\Arbitarr.Core\Arbitarr.Core.csproj" />
    <ProjectReference Include="..\..\src\Arbitarr.Core.Identity\Arbitarr.Core.Identity.csproj" />
    <ProjectReference Include="..\..\src\Arbitarr.Media\Arbitarr.Media.csproj" />
    <ProjectReference Include="..\..\src\Arbitarr.Ai\Arbitarr.Ai.csproj" />
    <ProjectReference Include="..\Arbitarr.TestSupport\Arbitarr.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\fixtures\nzbhydra\*.xml" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The parallelism cap (arb-rga.4) only takes effect if the runner finds this file BESIDE the
         test assembly. Without CopyToOutputDirectory it stays in the source tree, the runner never
         reads it, and the assembly silently runs at the default unbounded width — green, and not
         what was measured. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
