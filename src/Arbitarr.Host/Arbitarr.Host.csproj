<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Issue #46/R1: build identity, threaded from the Dockerfile's build args (via
    `dotnet publish -p:CommitSha=... -p:ImageTag=... -p:BuildTimestampUtc=...`) down to assembly
    metadata that Arbitarr.Api.SystemInfo.BuildInfo reads at startup. All three default to empty here
    so a plain local `dotnet build`/`dotnet run` with no properties supplied produces an assembly
    with no AssemblyMetadata entry for these keys; BuildInfo.ReadOnce treats that as unset and
    renders "unknown (local build)" rather than a blank or stale value.

    SourceRevisionId flows into AssemblyInformationalVersionAttribute automatically when set
    (the standard MSBuild source-control mechanism), so InformationalVersion needs no separate
    property of its own here.
  -->
  <PropertyGroup>
    <CommitSha Condition="'$(CommitSha)' == ''"></CommitSha>
    <ImageTag Condition="'$(ImageTag)' == ''"></ImageTag>
    <BuildTimestampUtc Condition="'$(BuildTimestampUtc)' == ''"></BuildTimestampUtc>
    <SourceRevisionId Condition="'$(CommitSha)' != ''">$(CommitSha)</SourceRevisionId>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CommitSha" Value="$(CommitSha)" />
    <AssemblyMetadata Include="ImageTag" Value="$(ImageTag)" />
    <AssemblyMetadata Include="BuildTimestampUtc" Value="$(BuildTimestampUtc)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arbitarr.Core\Arbitarr.Core.csproj" />
    <ProjectReference Include="..\Arbitarr.Api\Arbitarr.Api.csproj" />
    <ProjectReference Include="..\Arbitarr.Ai\Arbitarr.Ai.csproj" />
    <ProjectReference Include="..\Arbitarr.Data\Arbitarr.Data.csproj" />
    <ProjectReference Include="..\Arbitarr.Media\Arbitarr.Media.csproj" />
    <ProjectReference Include="..\Arbitarr.Sources.NzbHydra\Arbitarr.Sources.NzbHydra.csproj" />
    <!-- arb-x7w8.4: SourceRegistry builds the direct Newznab/Torznab adapter for rows of those
         kinds. AC6 reserves every Arbitarr.Sources.* reference to this project, the sole
         composition root (ADR 0001), so this edge belongs here and nowhere else. -->
    <ProjectReference Include="..\Arbitarr.Sources.Newznab\Arbitarr.Sources.Newznab.csproj" />
  </ItemGroup>

</Project>
