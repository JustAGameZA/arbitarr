<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Core ONLY. The Source row's columns reach this adapter as NewznabSourceOptions, not as an
    Arbitarr.Data entity: taking a ProjectReference on Data to read ApiPath/TimeoutSeconds would
    couple a wire-protocol adapter to the persistence schema, and the registry (arb-x7w8.4) is the
    layer whose job it is to project one onto the other.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Arbitarr.Core\Arbitarr.Core.csproj" />
  </ItemGroup>

</Project>
