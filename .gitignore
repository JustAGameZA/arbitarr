review-receipts/
.claude/

# Beads issue tracker runs in stealth mode in this public repo (bd init --stealth):
# the Dolt store and its embedded memories must never reach a fresh clone. Until now
# this was enforced only by .git/info/exclude, which is per-clone and local-only, so
# a fresh clone inherited no protection at all. This entry is the durable half.
.beads/

# .NET build artifacts
bin/
obj/
*.user
.vs/
TestResults/

# Secrets and local configuration — never commit
.env
.env.*
*.env
!*.env.example
secrets.json
appsettings.Local.json
appsettings.*.Local.json
appsettings.Development.json
*.secrets.json
infra.env

# Keys and certificates
*.pfx
*.p12
*.key
*.pem
*.crt
*.snk

# Runtime data directories
/config/
*.db
*.sqlite
*.sqlite3

# Test result artifacts (.trx logger output)
TestResults/

# Frontend toolchain
node_modules/
dist/
.vite/
*.tsbuildinfo
coverage/
vitest-report.json

# Host-built SPA bundle (Step 5b). `npm run build` writes here via vite.config.ts's
# outDir, and the image builds its own copy, so the output is never committed.
#
# The directory itself MUST survive, hence the .gitkeep negation below: git does not
# track empty directories, and UseStaticFiles/MapFallbackToFile resolve the web root
# at startup and throw DirectoryNotFoundException if it is missing. Ignoring the path
# without keeping it would break every integration test on a fresh clone -- measured,
# not hypothesised.
#
# Caveat: `npm run build` DELETES this .gitkeep, because vite.config.ts sets
# emptyOutDir: true on this directory. That shows up as a spurious deletion in
# `git status` after a local build. Restore it (`git checkout -- ` the path); do not
# commit its removal, or a fresh clone loses the directory and the host stops booting.
src/Arbitarr.Host/wwwroot/*
!src/Arbitarr.Host/wwwroot/.gitkeep
